# Public configuration (safe to ship in browser bundle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only. Never prefix either secret with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
QUOTA_COOKIE_SECRET=
# 60 platform minutes/day, independent of user refunds.
QUOTA_DAILY_SECONDS=3600
# Keep disabled: no trusted platform processor ships in this release.
PLATFORM_PROCESSING_DISABLED=true
# Video import worker (server-only; separate from Google/Supabase login).
VIDEO_IMPORT_WORKER_URL=
# Random shared secret, at least 32 characters. Never use VITE_ prefix.
VIDEO_IMPORT_WORKER_SECRET=
